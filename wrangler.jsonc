{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "347movies",
  "pages_build_output_dir": "public",
  "compatibility_date": "2026-08-15",
  // KV cache namespace (24h layer behind the edge cache). Created 2026-10-18; the id
  // below is the production namespace. The site still runs fully if KV ever comes back
  // empty — cache misses fall through to archive.org.
  // Public site URL used for canonical/OG tags. Override per environment if needed.
  "kv_namespaces": [
    { "binding": "MOVIES_KV", "id": "c4f2150c4ccf454999f2986c75c84b1d", "preview_id": "c4f2150c4ccf454999f2986c75c84b1d" }
  ],
  "vars": {
    "SITE_URL": "https://347movies.pages.dev"
  }
}
